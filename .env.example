# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# The same variables go into Vercel → Project → Settings → Environment Variables.

# --- Database (PostgreSQL) ---------------------------------------------------
# Supabase: Project → Connect → ORMs → Prisma shows both strings.
#   DATABASE_URL = Transaction pooler, port 6543 (add ?pgbouncer=true&connection_limit=1)
#   DIRECT_URL   = Session pooler, port 5432 (used only by `prisma migrate`)
# Local Postgres: use the same URL for both, e.g.
#   postgresql://postgres:postgres@localhost:5432/pla_dev
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Admin login -------------------------------------------------------------
# Password for /admin. Use a long random value (at least 12 characters).
# If empty, /admin login is disabled.
ADMIN_PASSWORD=""
